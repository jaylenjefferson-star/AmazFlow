{
  "manifest_version": 3,
  "name": "AmazFlow Agent",
  "version": "0.8.0",
  "description": "Signs in to AmazFlow and executes approved workflow steps in your browser. No per-site setup, no console tab to keep open.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AmazFlow Agent"
  }
}
