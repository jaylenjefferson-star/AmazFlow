{
  "manifest_version": 3,
  "name": "AmazFlow Agent",
  "version": "0.2.0",
  "description": "Executes narrowly scoped AmazFlow operations tasks in authorized browser tabs.",
  "permissions": ["activeTab", "storage", "alarms", "scripting", "permissions"],
  "host_permissions": ["https://5jsi2v2k35.execute-api.us-east-1.amazonaws.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "AmazFlow Agent" }
}
