{
  "name": "@amazflow/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js",
    "migrate:copilot-memory": "tsx src/import-copilot-memory.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@amazflow/engine": "workspace:*",
    "@amazflow/permissions": "workspace:*",
    "@amazflow/workflow-schema": "workspace:*",
    "@amplitude/ai": "^0.16.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1128.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1128.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1128.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1128.0",
    "@aws-sdk/client-dynamodb": "^3.1128.0",
    "@aws-sdk/client-secrets-manager": "^3.1128.0",
    "@aws-sdk/client-sesv2": "^3.1128.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
